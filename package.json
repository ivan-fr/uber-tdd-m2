{
  "name": "uber-tdd-m2",
  "version": "1.0.0",
  "description": "Projet Uber : reservation, annulation et historique via une API avec PostgreSQL",
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --import tsx infra/server.ts",
    "test:e2e": "vitest run --config ./test/vitest-e2e.config.ts",
    "scan": "node --env-file=.env --import tsx infra/scan-addresses.ts",
    "test:integration": "vitest run --config ./test/vitest-integration.config.ts",
    "test:integration:uber": "vitest run --config ./test/vitest-integration.config.ts",
    "db:start": "docker compose -p uber-tdd-m2 -f infra/docker-compose.yml up -d --wait",
    "db:stop": "docker compose -p uber-tdd-m2 -f infra/docker-compose.yml down",
    "knex": "knex --knexfile ./infra/knexfile.cjs"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/express": "^5.0.6",
    "@types/node": "24.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "testcontainers": "^11.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "express": "^5.3.0",
    "knex": "^3.1.0",
    "pg": "^8.16.3"
  }
}
